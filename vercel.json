{
  "functions": {
    "api/*.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/homework",
      "destination": "/api/study?fn=homework"
    },
    {
      "source": "/api/learn",
      "destination": "/api/study?fn=learn"
    },
    {
      "source": "/api/writing",
      "destination": "/api/study?fn=writing"
    },
    {
      "source": "/api/snippets",
      "destination": "/api/study?fn=snippets"
    },
    {
      "source": "/api/speaking",
      "destination": "/api/study?fn=speaking"
    },
    {
      "source": "/api/bookinfo",
      "destination": "/api/study?fn=bookinfo"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "reports": false
    }
  }
}